# Local substitutes only. The local script explicitly targets loopback DynamoDB.
PORT=3000
APP_ORIGIN=http://localhost:3000
# Optional AWS scanning: the runtime role trusted by customer account roles.
# Set this and configure the AWS SDK credential chain (e.g. AWS_PROFILE).
# CLOUDSENTINEL_AWS_PRINCIPAL_ARN=arn:aws:iam::111111111111:role/CloudSentinelRuntime
# AWS_PROFILE=cloudsentinel-runtime
# Required for deployed MFA; 64 hexadecimal characters, securely generated and backed up.
# Locally, scripts/server.ts persists a generated key at .local/mfa.key if omitted.
# MFA_ENCRYPTION_KEY=

# Container runtime defaults HOST=0.0.0.0. Host development defaults to loopback.
# HOST=0.0.0.0
# APP_ENV=local
# DYNAMODB_LOCAL_ENDPOINT=http://dynamodb:8000
# AWS mode requires HTTPS APP_ORIGIN, IDENTITY_TABLE and MFA_ENCRYPTION_KEY.
# APP_ENV=aws
# IDENTITY_TABLE=cloudsentinel-identity
# AWS_REGION=us-east-1
